{
  "name": "@flowdesk",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@flowdesk/api",
    "build": "pnpm --filter @flowdesk/database contract:emit && turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "db:init": "pnpm --filter @flowdesk/database db:init",
    "db:update": "pnpm --filter @flowdesk/database db:update",
    "db:emit": "pnpm --filter @flowdesk/database contract:emit"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
